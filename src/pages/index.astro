---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { getCollection } from 'astro:content';
import stats from '../data/stats.json';
import site from '../data/site.json';
import videos from '../data/videos.json';
import { fetchLatestVideos } from '../lib/youtube.ts';

// ─── Collections ───
const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featuredPosts = allPosts.slice(0, 3);

const allStories = (await getCollection('stories', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const featuredStories = allStories.slice(0, 3);

const allGallery = (await getCollection('gallery'))
  .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));

const advisory = (await getCollection('advisory'))
  .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));

const socials = (await getCollection('socials'))
  .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));

const galleryCategories = [
  { key: 'field',       label: 'Field' },
  { key: 'conferences', label: 'Conferences' },
  { key: 'community',   label: 'Community' },
  { key: 'personal',    label: 'Personal' },
] as const;

const ytVideos = videos.show_section
  ? await fetchLatestVideos(videos.channel_id, 6, videos.pinned_url)
  : [];

function fmtMonthYear(d: Date): string {
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
function readingTime(body: string): number {
  return Math.max(1, Math.round(body.trim().split(/\s+/).length / 220));
}
---
<Base>
  <!-- ─── NAV ─── -->
  <nav id="nav">
    <a href="/" class="nav-logo">
      <span>AB.</span>
      <span class="nav-logo-dot"></span>
    </a>
    <ul class="nav-links">
      <li><a href="#hero">Home</a></li>
      <li><a href="/about/">About</a></li>
      <li><a href="#advisory">Advisory</a></li>
      <li><a href="#photography">Photography</a></li>
      <li><a href="#videos">Videos</a></li>
      <li><a href="/field-notes/">Field Notes</a></li>
      <li><a href="/stories/">Stories</a></li>
      <li><a href="/publications/">Research</a></li>
    </ul>
    <div class="nav-socials">
      {socials.slice(0, 4).map((s) => (
        <a href={s.data.url} target={s.data.url.startsWith('http') ? '_blank' : undefined} rel="noopener" aria-label={s.data.platform}>
          <Icon name={s.data.icon} />
        </a>
      ))}
    </div>
  </nav>

  <!-- ═══ HERO ═══ -->
  <section id="hero" class="hero">
    <div class="container hero-grid">
      <div>
        <p class="hero-greeting">{site.hero_greeting}</p>
        <h1 class="hero-name">Dr. Animesh<br/><em>Biswas,</em><br/>PhD.</h1>
        <p class="hero-role">{site.hero_role}</p>
        <div class="hero-cta-row">
          <a class="btn btn-primary" href={site.hero_cta_primary_href}>
            <span>{site.hero_cta_primary_label}</span>
            <span class="arr">→</span>
          </a>
          <a class="btn btn-ghost" href={site.hero_cta_secondary_href}>
            <span>{site.hero_cta_secondary_label}</span>
            <span class="arr">→</span>
          </a>
        </div>
        <div class="hero-meta-row">
          <div class="hero-meta-col">
            <span class="hero-meta-label">Role</span>
            <span class="hero-meta-value">Global Health Expert</span>
          </div>
          <div class="hero-meta-col">
            <span class="hero-meta-label">Based</span>
            <span class="hero-meta-value">Dhaka, Bangladesh</span>
          </div>
          <div class="hero-meta-col">
            <span class="hero-meta-label">Advisory</span>
            <span class="hero-meta-value">WHO MPDSR TWG</span>
          </div>
        </div>
      </div>
      <div class="hero-photo-col">
        <div class="hero-photo-wrap">
          {site.hero_photo
            ? <img src={site.hero_photo} alt="Dr. Animesh Biswas" class="hero-photo" />
            : <div class="hero-photo-placeholder">Upload a hero photo in<br/>Site Settings → Hero photo</div>}
          <span class="hero-photo-corner hero-photo-corner-tl"></span>
          <span class="hero-photo-corner hero-photo-corner-br"></span>
        </div>
        <span class="hero-photo-frame"></span>
      </div>
    </div>
  </section>

  <!-- ═══ STATS ═══ -->
  <section class="stats">
    <div class="container">
      <div class="stats-grid">
        <div>
          <span class="stat-num"><em>{stats.publications}</em>{stats.publications_suffix}</span>
          <span class="stat-label">Publications</span>
        </div>
        <div>
          <span class="stat-num"><em>{stats.years}</em>{stats.years_suffix}</span>
          <span class="stat-label">Years of practice</span>
        </div>
        <div>
          <span class="stat-num"><em>{stats.countries}</em>{stats.countries_suffix}</span>
          <span class="stat-label">Countries reached</span>
        </div>
        <div>
          <span class="stat-num"><em>{stats.advisory_years}</em>{stats.advisory_suffix}</span>
          <span class="stat-label">Years on WHO advisory</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ SOCIALS GRID ═══ -->
  {socials.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-head">
          <p class="section-eyebrow">Socials</p>
          <h2 class="section-title">{site.section_socials_title.split(' ').slice(0, -1).join(' ')} <em>{site.section_socials_title.split(' ').slice(-1)}</em></h2>
          <p class="section-sub">{site.section_socials_sub}</p>
        </div>
        <div class="socials-grid">
          {socials.map((s) => (
            <a class="social-card" href={s.data.url} target={s.data.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
              <Icon name={s.data.icon} />
              <div>
                <div class="social-card-platform">{s.data.platform}</div>
                <span class="social-card-link">{s.data.label} <span>→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ MY STORY (preview) ═══ -->
  <section class="section section-tight">
    <div class="container">
      <div class="section-head">
        <div class="section-head-row">
          <div>
            <p class="section-eyebrow">About</p>
            <h2 class="section-title">My <em>Story</em></h2>
          </div>
          <a href="/about/" class="section-link">Read more <span>→</span></a>
        </div>
      </div>
      <div class="story-grid">
        {site.portrait
          ? <img src={site.portrait} alt="Dr. Animesh Biswas" class="story-photo" />
          : <div class="story-photo-placeholder">Portrait</div>}
        <div class="story-body">
          <p set:html={site.about_short}></p>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══ ADVISORY AREAS ═══ -->
  {advisory.length > 0 && (
    <section id="advisory" class="section section-alt">
      <div class="container">
        <div class="section-head">
          <p class="section-eyebrow">What I do</p>
          <h2 class="section-title">Advisory <em>Areas</em></h2>
          <p class="section-sub">{site.section_advisory_sub}</p>
        </div>
        <div class="advisory-grid">
          {advisory.map((a) => (
            <div class="advisory-card">
              <div class="advisory-icon"><Icon name={a.data.icon} /></div>
              <h3 class="advisory-title">{a.data.title}</h3>
              <p class="advisory-body">{a.data.body}</p>
              {a.data.bullets.length > 0 && (
                <ul class="advisory-list">
                  {a.data.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
            </div>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ PHOTOGRAPHY ═══ -->
  {allGallery.length > 0 && (
    <section id="photography" class="section">
      <div class="container">
        <div class="section-head">
          <p class="section-eyebrow">Visual archive</p>
          <h2 class="section-title">{site.section_gallery_title}</h2>
          <p class="section-sub">{site.section_gallery_sub}</p>
        </div>
        <div class="gallery-tabs" id="gallery-tabs">
          <button class="gallery-tab is-active" data-cat="all">All</button>
          {galleryCategories.map((c) => (
            <button class="gallery-tab" data-cat={c.key}>{c.label}</button>
          ))}
        </div>
        <div class="gallery-grid" id="gallery-grid">
          {allGallery.map((g, i) => {
            const sizeClass = g.data.featured ? 'is-wide' : '';
            return (
              <a class={`gallery-item ${sizeClass}`} data-cat={g.data.category} href={g.data.image} data-lightbox>
                <img src={g.data.image} alt={g.data.caption} loading="lazy" />
                <div class="gallery-fallback">{g.data.caption}</div>
                <div class="gallery-cap">{g.data.caption}{g.data.location ? ` · ${g.data.location}` : ''}</div>
              </a>
            );
          })}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ VIDEOS ═══ -->
  {videos.show_section && (
    <section id="videos" class="section section-alt">
      <div class="container">
        <div class="section-head">
          <div class="section-head-row">
            <div>
              <p class="section-eyebrow">From AniTap</p>
              <h2 class="section-title">{site.section_videos_title}</h2>
              <p class="section-sub">{site.section_videos_sub}</p>
            </div>
            <a class="section-link" href={`https://www.youtube.com/${videos.channel_handle}`} target="_blank" rel="noopener">
              Visit channel <span>→</span>
            </a>
          </div>
        </div>
        {ytVideos.length === 0 ? (
          <div class="videos-empty">YouTube channel ID not yet configured.</div>
        ) : (
          <div class="videos-grid">
            {ytVideos.map((v) => {
              const d = v.published ? new Date(v.published) : null;
              return (
                <a class="video-card" href={v.url} target="_blank" rel="noopener">
                  <div class="video-thumb">
                    <img src={v.thumbnail} alt={v.title} loading="lazy" />
                    <div class="video-play" aria-hidden="true">▶</div>
                    {v.isPinned && <span class="video-pin">Featured</span>}
                  </div>
                  <div class="video-meta">
                    {d && <div class="video-date">{fmtMonthYear(d)}</div>}
                    <h3 class="video-title">{v.title}</h3>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </section>
  )}

  <!-- ═══ FIELD NOTES PREVIEW ═══ -->
  {featuredPosts.length > 0 && (
    <section class="section">
      <div class="container">
        <div class="section-head">
          <div class="section-head-row">
            <div>
              <p class="section-eyebrow">The Work</p>
              <h2 class="section-title">Field <em>Notes</em></h2>
              <p class="section-sub">{site.section_field_notes_sub}</p>
            </div>
            <a class="section-link" href="/field-notes/">All field notes <span>→</span></a>
          </div>
        </div>
        <div class="posts-grid">
          {featuredPosts.map((p) => (
            <a class="post-card" href={`/field-notes/${p.slug}/`}>
              <div class="post-cover">
                {p.data.cover
                  ? <img src={p.data.cover} alt={p.data.title} loading="lazy" />
                  : <div class="post-cover-placeholder">{p.data.category}</div>}
              </div>
              <div class="post-body">
                <div class="post-meta">{p.data.category} · {readingTime(p.body)} min · {fmtMonthYear(p.data.date)}</div>
                <h3 class="post-title">{p.data.title}</h3>
                <p class="post-excerpt">{p.data.summary}</p>
                <span class="post-link">Read essay <span>→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ STORIES & POEMS PREVIEW ═══ -->
  {featuredStories.length > 0 && (
    <section class="section section-alt">
      <div class="container">
        <div class="section-head">
          <div class="section-head-row">
            <div>
              <p class="section-eyebrow">Personal writing</p>
              <h2 class="section-title">Stories &amp; <em>Poems</em></h2>
              <p class="section-sub">{site.section_stories_sub}</p>
            </div>
            <a class="section-link" href="/stories/">All writing <span>→</span></a>
          </div>
        </div>
        <div class="posts-grid">
          {featuredStories.map((p) => (
            <a class={`post-card ${p.data.language === 'bn' ? 'is-bn' : ''}`} href={`/stories/${p.slug}/`} lang={p.data.language}>
              <div class="post-cover">
                {p.data.cover
                  ? <img src={p.data.cover} alt={p.data.title} loading="lazy" />
                  : <div class="post-cover-placeholder">{p.data.kind}</div>}
              </div>
              <div class="post-body">
                <div class="post-meta">{p.data.kind} · {p.data.language === 'bn' ? 'বাংলা' : 'English'} · {fmtMonthYear(p.data.date)}</div>
                <h3 class="post-title">{p.data.title}</h3>
                <p class="post-excerpt">{p.data.summary}</p>
                <span class="post-link">Read <span>→</span></span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- ═══ CONTACT ═══ -->
  <section id="contact" class="contact">
    <div class="container">
      <p class="contact-overline"><span class="dot"></span>{site.contact_overline}</p>
      <h2 class="contact-cta" set:html={site.contact_cta}></h2>
      <a class="btn btn-primary" href={`mailto:${site.email}`}>
        <span>Get in touch</span>
        <span class="arr">→</span>
      </a>
      <div class="contact-channels">
        <a class="contact-channel" href={`mailto:${site.email}`}>
          <Icon name="email" /> {site.email}
        </a>
        {socials.map((s) => (
          <a class="contact-channel" href={s.data.url} target={s.data.url.startsWith('http') ? '_blank' : undefined} rel="noopener">
            <Icon name={s.data.icon} /> {s.data.platform}
          </a>
        ))}
      </div>
    </div>
  </section>

  <footer>
    <span>{site.footer_copy}</span>
    <span><a href="/about/">About</a> · <a href="/field-notes/">Field notes</a> · <a href="/stories/">Stories</a> · <a href="/publications/">Research</a></span>
  </footer>

  <!-- ─── Gallery filter + lightbox ─── -->
  <script is:inline>
    (function () {
      const tabs = document.querySelectorAll('#gallery-tabs .gallery-tab');
      const items = document.querySelectorAll('#gallery-grid .gallery-item');
      tabs.forEach((t) => t.addEventListener('click', () => {
        tabs.forEach((x) => x.classList.remove('is-active'));
        t.classList.add('is-active');
        const cat = t.getAttribute('data-cat');
        items.forEach((it) => {
          const show = cat === 'all' || it.getAttribute('data-cat') === cat;
          it.style.display = show ? '' : 'none';
        });
      }));

      const links = document.querySelectorAll('[data-lightbox]');
      if (links.length) {
        const overlay = document.createElement('div');
        overlay.className = 'lightbox';
        overlay.innerHTML = '<button class="lightbox-close" aria-label="Close">×</button><img alt="" />';
        document.body.appendChild(overlay);
        const lbImg = overlay.querySelector('img');
        const close = () => overlay.classList.remove('is-open');
        overlay.addEventListener('click', (e) => { if (e.target === overlay || e.target.classList.contains('lightbox-close')) close(); });
        document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
        links.forEach((a) => a.addEventListener('click', (e) => {
          const img = a.querySelector('img');
          if (!img || img.naturalWidth === 0) return;
          e.preventDefault();
          lbImg.src = a.getAttribute('href');
          overlay.classList.add('is-open');
        }));

        document.querySelectorAll('.gallery-item img').forEach((img) => {
          img.addEventListener('error', () => { img.parentElement.classList.add('img-missing'); });
        });
      }

      // Active nav-link highlight by scroll
      const sections = Array.from(document.querySelectorAll('section[id]'));
      const navLinks = document.querySelectorAll('.nav-links a[href^="#"]');
      function onScroll() {
        const y = window.scrollY + 120;
        let current = '';
        for (const s of sections) {
          if (s.offsetTop <= y) current = s.id;
        }
        navLinks.forEach((a) => {
          a.classList.toggle('is-active', a.getAttribute('href') === '#' + current);
        });
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      // Scroll-reveal — fade up section heads and cards as they enter
      const revealTargets = document.querySelectorAll('.section-head, .stat, .social-card, .advisory-card, .post-card, .video-card, .gallery-item, .hero-photo-col, .story-grid > *, .pub-item, .blog-list-item');
      revealTargets.forEach((el) => el.classList.add('reveal'));
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0.05 });
        revealTargets.forEach((el) => io.observe(el));
      } else {
        revealTargets.forEach((el) => el.classList.add('is-in'));
      }
    })();
  </script>
</Base>

<!-- ─── Inline icon component ─── -->
<script is:inline define:vars={{}}></script>

<!-- We use a tiny Astro component-as-fragment for icons below. -->
<!-- (Defined via component file: src/components/Icon.astro) -->
