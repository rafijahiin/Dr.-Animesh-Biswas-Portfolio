---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import stats from '../data/stats.json';
import site from '../data/site.json';
import videos from '../data/videos.json';
import { fetchLatestVideos } from '../lib/youtube.ts';

// ─── Content collections ───
const allPosts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const featuredPost = allPosts.find((p) => p.data.featured) ?? allPosts[0];
const otherPosts = allPosts.filter((p) => p.id !== featuredPost?.id).slice(0, 3);

const allPubs = (await getCollection('publications'))
  .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));

const allGallery = (await getCollection('gallery'))
  .sort((a, b) => (a.data.order ?? 100) - (b.data.order ?? 100));

// Gallery categories
const galleryCategories = [
  { key: 'field',       label: 'Field' },
  { key: 'conferences', label: 'Conferences' },
  { key: 'community',   label: 'Community' },
  { key: 'personal',    label: 'Personal' },
] as const;

// ─── YouTube (build-time fetch) ───
const ytVideos = videos.show_section
  ? await fetchLatestVideos(videos.channel_id, 4, videos.pinned_url)
  : [];

// Helpers
function fmtDate(d: Date): string {
  return d.toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
}
function readingTime(body: string): number {
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.round(words / 220));
}
---
<Base>
  <!-- ─── Ambient layers ─── -->
  <canvas id="webgl-hero" aria-hidden="true"></canvas>
  <canvas id="particles" aria-hidden="true"></canvas>
  <div class="grain" aria-hidden="true"></div>
  <div id="progress" aria-hidden="true"></div>

  <!-- Custom cursor -->
  <div id="cur"   aria-hidden="true"></div>
  <div id="cur-f" aria-hidden="true"></div>

  <!-- ─── PRELOADER ─── -->
  <div id="preloader" aria-hidden="true">
    <div class="pre-tag">A documentary in chapters</div>
    <div class="pre-name"><span>Animesh Biswas</span></div>
    <div class="pre-bar"><div class="pre-bar-inner" id="pre-bar-fill"></div></div>
    <div class="pre-meta">
      <span class="pre-count" id="pre-count">000</span>
      <span class="pre-sep">/</span>
      <span>100</span>
      <span class="pre-status" id="pre-status">Loading visual archive…</span>
    </div>
  </div>

  <!-- ─── NAV ─── -->
  <nav id="nav">
    <a class="nav-logo" href="#hero">
      <span class="nav-logo-mark">AB</span>
      <span class="nav-logo-dot"></span>
    </a>
    <ul class="nav-links">
      <li><a href="#ch1">01 Person</a></li>
      <li><a href="#ch2">02 Focus</a></li>
      <li><a href="#ch3">03 Impact</a></li>
      <li><a href="#ch4">04 Research</a></li>
      <li><a href="#ch5">05 Field</a></li>
      <li><a href="#ch6">06 Moments</a></li>
      {videos.show_section && <li><a href="#ch7">07 Diaries</a></li>}
    </ul>
    <a class="nav-btn" href="#contact">
      <span>Connect</span>
      <span class="nav-btn-arrow">→</span>
    </a>
  </nav>

  <!-- ═══════════════════════════════════════════ HERO ═══════════════════════════════════════════ -->
  <header id="hero">
    <div class="hero-overline">
      <span class="hero-overline-line"></span>
      <span>United Nations Population Fund · Bangladesh</span>
      <span class="hero-overline-line"></span>
    </div>

    <h1 class="hero-name" aria-label="Dr. Animesh Biswas, PhD">
      <span class="hero-line"><span class="hero-letter-row">Dr.&nbsp;Animesh</span></span>
      <span class="hero-line hero-line-italic"><span class="hero-letter-row">Biswas,</span></span>
      <span class="hero-line"><span class="hero-letter-row">PhD<span class="hero-name-dot">.</span></span></span>
    </h1>

    <div class="hero-meta">
      <div class="hero-meta-col"><span class="hero-meta-label">Role</span><span class="hero-meta-value">Global Health Expert</span></div>
      <div class="hero-meta-col"><span class="hero-meta-label">Practice</span><span class="hero-meta-value">Maternal & Reproductive Health</span></div>
      <div class="hero-meta-col"><span class="hero-meta-label">Advisory</span><span class="hero-meta-value">WHO MPDSR Technical Working Group</span></div>
      <div class="hero-meta-col"><span class="hero-meta-label">Field</span><span class="hero-meta-value">SRH in Humanitarian Emergencies</span></div>
    </div>

    <div class="hero-scroll" aria-hidden="true">
      <span class="hero-scroll-label">Begin</span>
      <span class="hero-scroll-line"></span>
      <span class="hero-scroll-chap">Chapter 01</span>
    </div>

    <div class="hero-edge" aria-hidden="true">
      <span class="hero-edge-l">N 23°41′ · E 90°22′ — Dhaka</span>
      <span class="hero-edge-r">2014 — 2026 · A practice</span>
    </div>
  </header>

  <!-- ═══════════════════════════════════════════ CHAPTER 01 — PERSON ═══════════════════════════════════════════ -->
  <section id="ch1" class="chapter" data-chapter="01" data-chapter-title="The Person">
    <div class="chapter-card">
      <div class="chapter-card-inner">
        <span class="chapter-card-num">01</span>
        <span class="chapter-card-line"></span>
        <h2 class="chapter-card-title">The <em>Person</em></h2>
        <p class="chapter-card-sub">A decade at the intersection of <br/>health, policy, and humanity.</p>
        <span class="chapter-card-coord">N 23°41′ · E 90°22′</span>
      </div>
    </div>

    <div class="ch1-stage">
      <div class="ch1-portrait">
        <div class="ch1-portrait-frame">
          <div class="placeholder placeholder-portrait">
            <span class="placeholder-cross"></span>
            <span class="placeholder-label">Portrait · 3:4 · field shot, b/w</span>
          </div>
        </div>
        <span class="ch1-portrait-caption">Plate I — On assignment, Cox's Bazar</span>
      </div>

      <div class="ch1-content">
        <p class="ch1-eyebrow"><span class="dot"></span> A short biography</p>

        <p class="ch1-lede">
          Dr. Animesh Biswas is a global health practitioner at <em>UNFPA Bangladesh</em>, working at the difficult edges of reproductive health — where policy meets crisis, and where systems must be built before they can be measured.
        </p>

        <div class="ch1-body">
          <p>He pioneered the use of <strong>Cash and Voucher Assistance for Sexual and Reproductive Health outcomes</strong> in humanitarian emergencies — a model now studied, validated and replicated across multiple countries. The work began in the Rohingya response in Cox's Bazar and has since travelled.</p>
          <p>A standing member of the <strong>WHO Global MPDSR Technical Working Group</strong> for over five years, he has contributed case studies to WHO's 2024 global report and advised on the international guidance for cash-based programming in SRH.</p>
        </div>

        <div class="ch1-tags">
          <span class="tag">UNFPA Bangladesh</span>
          <span class="tag">WHO Advisory</span>
          <span class="tag">Maternal Health</span>
          <span class="tag">MPDSR</span>
          <span class="tag">Humanitarian SRH</span>
          <span class="tag">Cash & Voucher</span>
          <span class="tag">Obstetric Fistula</span>
          <span class="tag">PhD</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ CHAPTER 02 — FOCUS ═══════════════════════════════════════════ -->
  <section id="ch2" class="chapter chapter-focus" data-chapter="02" data-chapter-title="Focus">
    <div class="chapter-card">
      <div class="chapter-card-inner">
        <span class="chapter-card-num">02</span>
        <span class="chapter-card-line"></span>
        <h2 class="chapter-card-title">In <em>Focus</em></h2>
        <p class="chapter-card-sub">Four practice areas, woven across<br/>policy, programme and field.</p>
        <span class="chapter-card-coord">Scroll → to advance</span>
      </div>
    </div>

    <div class="focus-pin">
      <div class="focus-track" id="focus-track">
        <article class="focus-card" tabindex="0">
          <div class="focus-card-head"><span class="focus-card-num">01 / 04</span><span class="focus-card-tag">Practice area</span></div>
          <div class="focus-card-glyph" aria-hidden="true">
            <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1">
              <circle cx="40" cy="32" r="14"/><path d="M40 46 v22 M28 56 h24"/><circle cx="40" cy="32" r="22" stroke-dasharray="3 4" opacity=".5"/>
            </svg>
          </div>
          <h3 class="focus-card-title">Maternal & <em>Perinatal</em> Health</h3>
          <p class="focus-card-body">Evidence-based strategies to reduce maternal mortality at community and facility level — field-tested across Bangladesh and cited in global guidance.</p>
          <ul class="focus-card-list">
            <li>Community case-management protocols</li>
            <li>Facility-readiness audit frameworks</li>
            <li>Mortality reduction strategies, evidence-based</li>
          </ul>
        </article>

        <article class="focus-card" tabindex="0">
          <div class="focus-card-head"><span class="focus-card-num">02 / 04</span><span class="focus-card-tag">Systems</span></div>
          <div class="focus-card-glyph" aria-hidden="true">
            <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1">
              <rect x="14" y="14" width="52" height="52"/><path d="M14 30 h52 M14 46 h52 M30 14 v52 M46 14 v52"/><circle cx="30" cy="30" r="3" fill="currentColor"/><circle cx="46" cy="46" r="3" fill="currentColor"/>
            </svg>
          </div>
          <h3 class="focus-card-title"><em>MPDSR</em> Systems</h3>
          <p class="focus-card-body">Advancing Maternal Perinatal Death Surveillance & Response through the WHO Technical Working Group — translating global policy into country-level practice.</p>
          <ul class="focus-card-list">
            <li>WHO TWG standing member, 5+ years</li>
            <li>Case study, WHO 2024 global MPDSR report</li>
            <li>National implementation, Bangladesh</li>
          </ul>
        </article>

        <article class="focus-card" tabindex="0">
          <div class="focus-card-head"><span class="focus-card-num">03 / 04</span><span class="focus-card-tag">Crisis response</span></div>
          <div class="focus-card-glyph" aria-hidden="true">
            <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M40 14 L66 60 H14 Z"/><path d="M40 32 v14 M40 52 v2"/><circle cx="40" cy="40" r="28" stroke-dasharray="2 5" opacity=".4"/>
            </svg>
          </div>
          <h3 class="focus-card-title">SRH in <em>Emergencies</em></h3>
          <p class="focus-card-body">Designing and delivering Sexual & Reproductive Health programmes for displaced and crisis-affected populations, including the Rohingya response in Cox's Bazar.</p>
          <ul class="focus-card-list">
            <li>Rohingya response, Cox's Bazar</li>
            <li>Minimum Initial Service Package design</li>
            <li>Cross-agency coordination, UN cluster</li>
          </ul>
        </article>

        <article class="focus-card" tabindex="0">
          <div class="focus-card-head"><span class="focus-card-num">04 / 04</span><span class="focus-card-tag">Innovation</span></div>
          <div class="focus-card-glyph" aria-hidden="true">
            <svg viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="1">
              <path d="M40 14 L62 28 V52 L40 66 L18 52 V28 Z"/><path d="M40 14 V40 M40 40 L62 28 M40 40 L18 28 M40 40 V66" opacity=".5"/>
            </svg>
          </div>
          <h3 class="focus-card-title">Cash & Voucher for <em>SRH</em></h3>
          <p class="focus-card-body">Pioneered CVA for Sexual and Reproductive Health outcomes in humanitarian emergencies — a model validated and replicated in multiple countries internationally.</p>
          <ul class="focus-card-list">
            <li>First-of-kind programme, Bangladesh</li>
            <li>Global guidance, contributor</li>
            <li>Replicated across multiple geographies</li>
          </ul>
        </article>
      </div>

      <div class="focus-rail" aria-hidden="true">
        <div class="focus-rail-bar"><div class="focus-rail-fill" id="focus-rail-fill"></div></div>
        <span class="focus-rail-label">Drag · scroll · swipe</span>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ CHAPTER 03 — IMPACT (DYNAMIC NUMBERS) ═══════════════════════════════════════════ -->
  <section id="ch3" class="chapter chapter-impact" data-chapter="03" data-chapter-title="Impact">
    <div class="chapter-card chapter-card-light">
      <div class="chapter-card-inner">
        <span class="chapter-card-num">03</span>
        <span class="chapter-card-line"></span>
        <h2 class="chapter-card-title">By the <em>Numbers</em></h2>
        <p class="chapter-card-sub">Where the work has reached,<br/>and what it has touched.</p>
        <span class="chapter-card-coord">2014 — 2026</span>
      </div>
    </div>

    <div class="impact-stage">
      <div class="impact-grid">
        <div class="impact-cell" data-target={stats.publications} data-suffix={stats.publications_suffix}>
          <span class="impact-num" data-num>0</span>
          <span class="impact-label">Publications &amp; research outputs</span>
          <span class="impact-sub">Peer-reviewed, grey literature, technical reports</span>
        </div>
        <div class="impact-cell" data-target={stats.years} data-suffix={stats.years_suffix}>
          <span class="impact-num" data-num>0</span>
          <span class="impact-label">Years of global health practice</span>
          <span class="impact-sub">UNFPA, NGO partners, ministries</span>
        </div>
        <div class="impact-cell" data-target={stats.countries} data-suffix={stats.countries_suffix}>
          <span class="impact-num" data-num>0</span>
          <span class="impact-label">Countries with programme reach</span>
          <span class="impact-sub">Direct delivery and model replication</span>
        </div>
        <div class="impact-cell" data-target={stats.advisory_years} data-suffix={stats.advisory_suffix}>
          <span class="impact-num" data-num>0</span>
          <span class="impact-label">Years on WHO advisory</span>
          <span class="impact-sub">MPDSR Global Technical Working Group</span>
        </div>
      </div>

      <div class="impact-marquee" aria-hidden="true">
        <div class="impact-marquee-track">
          <span>Maternal Health</span><span>·</span>
          <span>MPDSR</span><span>·</span>
          <span>UNFPA</span><span>·</span>
          <span>WHO Advisory</span><span>·</span>
          <span>SRH Emergencies</span><span>·</span>
          <span>Cash &amp; Voucher</span><span>·</span>
          <span>Obstetric Fistula</span><span>·</span>
          <span>Cox's Bazar</span><span>·</span>
          <span>Bangladesh</span><span>·</span>
          <span>Maternal Health</span><span>·</span>
          <span>MPDSR</span><span>·</span>
          <span>UNFPA</span><span>·</span>
          <span>WHO Advisory</span><span>·</span>
          <span>SRH Emergencies</span><span>·</span>
          <span>Cash &amp; Voucher</span><span>·</span>
          <span>Obstetric Fistula</span><span>·</span>
          <span>Cox's Bazar</span><span>·</span>
          <span>Bangladesh</span><span>·</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ CHAPTER 04 — RESEARCH (DYNAMIC PUBS) ═══════════════════════════════════════════ -->
  <section id="ch4" class="chapter chapter-research" data-chapter="04" data-chapter-title="Research">
    <div class="chapter-card">
      <div class="chapter-card-inner">
        <span class="chapter-card-num">04</span>
        <span class="chapter-card-line"></span>
        <h2 class="chapter-card-title">The <em>Record</em></h2>
        <p class="chapter-card-sub">Selected publications, citations,<br/>and contributions to global guidance.</p>
        <span class="chapter-card-coord">{stats.publications}{stats.publications_suffix} outputs</span>
      </div>
    </div>

    <div class="pub-table">
      <div class="pub-table-head">
        <span>Year</span>
        <span>Title &amp; abstract</span>
        <span>Venue</span>
        <span class="pub-table-action">↗</span>
      </div>

      {allPubs.map((p) => (
        <a href={p.data.url ?? '#ch4'} class="pub-row" data-pub target={p.data.url ? '_blank' : undefined} rel={p.data.url ? 'noopener' : undefined}>
          <span class="pub-year">{p.data.year}</span>
          <div class="pub-body">
            <h4 class="pub-title">{p.data.title}</h4>
            <p class="pub-abs">{p.data.abstract}</p>
            <div class="pub-tags">
              {p.data.tags.map((t) => <span>{t}</span>)}
            </div>
          </div>
          <span class="pub-venue">
            <span class="pub-venue-name">{p.data.venue_name}</span>
            <span class="pub-venue-sub">{p.data.venue_sub}</span>
          </span>
          <span class="pub-action" aria-hidden="true">↗</span>
        </a>
      ))}
    </div>

    <div class="pub-foot">
      <span class="pub-foot-label">A partial record — {stats.publications}{stats.publications_suffix} further outputs available on request.</span>
      {site.bibliography_pdf
        ? <a href={site.bibliography_pdf} class="pub-foot-link" target="_blank" rel="noopener">Download bibliography <span>→</span></a>
        : <a href={`mailto:${site.email}?subject=Bibliography request`} class="pub-foot-link">Request bibliography <span>→</span></a>}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ CHAPTER 05 — FIELD NOTES (DYNAMIC) ═══════════════════════════════════════════ -->
  <section id="ch5" class="chapter chapter-field" data-chapter="05" data-chapter-title="Field Notes">
    <div class="chapter-card">
      <div class="chapter-card-inner">
        <span class="chapter-card-num">05</span>
        <span class="chapter-card-line"></span>
        <h2 class="chapter-card-title">Field <em>Notes</em></h2>
        <p class="chapter-card-sub">Dispatches, essays, and case notes<br/>from a working practice.</p>
        <span class="chapter-card-coord">{allPosts.length} read{allPosts.length === 1 ? '' : 's'}</span>
      </div>
    </div>

    <div class="field-track" id="field-track">
      {featuredPost && (
        <article class="field-card field-card-feature">
          <div class="field-card-thumb">
            {featuredPost.data.cover
              ? <img src={featuredPost.data.cover} alt={featuredPost.data.title} loading="lazy" />
              : (
                <div class="placeholder placeholder-landscape">
                  <span class="placeholder-cross"></span>
                  <span class="placeholder-label">Featured visual · 4:3 · field documentary</span>
                </div>
              )}
            <span class="field-card-num">01</span>
            <span class="field-card-badge">Featured essay</span>
          </div>
          <div class="field-card-body">
            <p class="field-card-meta">{featuredPost.data.category}  ·  {readingTime(featuredPost.body)} min read  ·  {fmtDate(featuredPost.data.date)}</p>
            <h3 class="field-card-title">{featuredPost.data.title}</h3>
            <p class="field-card-excerpt">{featuredPost.data.summary}</p>
            <a href={`/field-notes/${featuredPost.slug}/`} class="field-card-link">Read essay <span>→</span></a>
          </div>
        </article>
      )}

      {otherPosts.map((p, i) => (
        <article class="field-card">
          <div class="field-card-thumb">
            {p.data.cover
              ? <img src={p.data.cover} alt={p.data.title} loading="lazy" />
              : (
                <div class="placeholder placeholder-landscape">
                  <span class="placeholder-cross"></span>
                  <span class="placeholder-label">Visual · 16:10</span>
                </div>
              )}
            <span class="field-card-num">{String(i + 2).padStart(2, '0')}</span>
            <span class="field-card-badge">{p.data.category}</span>
          </div>
          <div class="field-card-body">
            <p class="field-card-meta">{p.data.category}  ·  {readingTime(p.body)} min read  ·  {fmtDate(p.data.date)}</p>
            <h3 class="field-card-title">{p.data.title}</h3>
            <p class="field-card-excerpt">{p.data.summary}</p>
            <a href={`/field-notes/${p.slug}/`} class="field-card-link">Read essay <span>→</span></a>
          </div>
        </article>
      ))}
    </div>

    {allPosts.length > 4 && (
      <div class="pub-foot">
        <a href="/field-notes/" class="pub-foot-link">All field notes <span>→</span></a>
      </div>
    )}
  </section>

  <!-- ═══════════════════════════════════════════ CHAPTER 06 — MOMENTS (CATEGORIZED GALLERY) ═══════════════════════════════════════════ -->
  <section id="ch6" class="chapter chapter-moments" data-chapter="06" data-chapter-title="Moments">
    <div class="chapter-card">
      <div class="chapter-card-inner">
        <span class="chapter-card-num">06</span>
        <span class="chapter-card-line"></span>
        <h2 class="chapter-card-title">Field &amp; <em>Moments</em></h2>
        <p class="chapter-card-sub">A small visual archive from<br/>a decade of practice.</p>
        <span class="chapter-card-coord">{allGallery.length} plate{allGallery.length === 1 ? '' : 's'}</span>
      </div>
    </div>

    <div class="moments-tabs" id="moments-tabs">
      <button class="moments-tab is-active" data-cat="all">All</button>
      {galleryCategories.map((c) => (
        <button class="moments-tab" data-cat={c.key}>{c.label}</button>
      ))}
    </div>

    <div class="moments-grid" id="moments-grid">
      {allGallery.map((g, i) => {
        const sizeClass = g.data.featured ? 'moments-item-xl' : (i % 5 === 4 ? 'moments-item-wide' : '');
        return (
          <figure class={`moments-item ${sizeClass}`} data-cat={g.data.category}>
            <a href={g.data.image} data-lightbox class="moments-link">
              <img src={g.data.image} alt={g.data.caption} loading="lazy" onerror="this.parentElement.classList.add('img-missing')" />
              <div class="placeholder placeholder-landscape moments-fallback">
                <span class="placeholder-cross"></span>
                <span class="placeholder-label">{g.data.caption}</span>
              </div>
            </a>
            <figcaption>
              <span class="moments-cap">{g.data.caption}</span>
              <span class="moments-sub">{g.data.location ?? ''}{g.data.date ? ` · ${g.data.date.getFullYear()}` : ''}</span>
            </figcaption>
          </figure>
        );
      })}
    </div>
  </section>

  <!-- ═══════════════════════════════════════════ CHAPTER 07 — DIARIES (YOUTUBE) ═══════════════════════════════════════════ -->
  {videos.show_section && (
    <section id="ch7" class="chapter chapter-diaries" data-chapter="07" data-chapter-title="Diaries">
      <div class="chapter-card">
        <div class="chapter-card-inner">
          <span class="chapter-card-num">07</span>
          <span class="chapter-card-line"></span>
          <h2 class="chapter-card-title">{videos.section_title}</h2>
          <p class="chapter-card-sub" set:html={videos.section_subtitle.replace(/\n/g, '<br/>')}></p>
          <span class="chapter-card-coord">{videos.channel_handle}</span>
        </div>
      </div>

      <div class="diaries-grid">
        {ytVideos.length === 0 ? (
          <div class="diaries-empty">
            <p class="placeholder-label">
              YouTube channel ID not set yet. Add it in <a href="/admin/#/collections/settings/entries/videos" style="text-decoration: underline">Site Settings → YouTube Section</a>.
            </p>
            <a class="diaries-channel-link" href={`https://www.youtube.com/${videos.channel_handle}`} target="_blank" rel="noopener">
              Visit channel <span>→</span>
            </a>
          </div>
        ) : (
