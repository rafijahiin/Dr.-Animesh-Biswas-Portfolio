  <!-- POST 6: My Story (Bengali) -->
  <item>
    <title>মা</title>
    <link>https://animeshbiswas.com/2024/12/01/ma/</link>
    <pubDate>Sun, 01 Dec 2024 00:00:00 +0000</pubDate>
    <dc:creator><![CDATA[animesh]]></dc:creator>
    <guid isPermaLink="false">https://animeshbiswas.com/?p=202</guid>
    <description></description>
    <content:encoded><![CDATA[
<!-- wp:paragraph -->
<p><em>একটি ছোট কবিতা — মাতৃমৃত্যু পর্যালোচনা সভার পর লেখা।</em></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>মা,<br>তুমি জানো না,<br>তোমার নাম একটি সংখ্যা হয়ে গেছে<br>একটি ফর্মের একটি ঘরে।</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>ফর্মটি পূরণ হয়,<br>সংখ্যাটি যোগ হয়,<br>এবং একটি প্রতিবেদন তৈরি হয়<br>যা কেউ পড়ে না।</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>কিন্তু তোমার মেয়ে,<br>যে এখন স্কুলে যাচ্ছে,<br>সে তোমার নামটি প্রতি রাতে বলে<br>বাতি নিভানোর আগে।</p>
<!-- /wp:paragraph -->
]]></content:encoded>
    <excerpt:encoded><![CDATA[একটি ছোট কবিতা — মাতৃমৃত্যু পর্যালোচনা সভার পর লেখা।]]></excerpt:encoded>
    <wp:post_id>202</wp:post_id>
