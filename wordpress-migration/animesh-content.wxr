  <!-- POST 2: Travel Blog -->
  <item>
    <title>Cash as Care: Rethinking SRH Delivery in Humanitarian Settings</title>
    <link>https://animeshbiswas.com/2025/01/20/cash-as-care/</link>
    <pubDate>Mon, 20 Jan 2025 00:00:00 +0000</pubDate>
    <dc:creator><![CDATA[animesh]]></dc:creator>
    <guid isPermaLink="false">https://animeshbiswas.com/?p=102</guid>
    <description></description>
    <content:encoded><![CDATA[
<!-- wp:paragraph -->
<p><em>How unconditional cash transfers are transforming reproductive health access in crisis contexts — and why the model works where clinics cannot reach.</em></p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p>Cash and voucher assistance is no longer a fringe modality in humanitarian SRH. What began as an experiment in the Rohingya response has matured into a recognized model — but the lessons are still being absorbed.</p>
<!-- /wp:paragraph -->
]]></content:encoded>
    <excerpt:encoded><![CDATA[How unconditional cash transfers are transforming reproductive health access in crisis contexts — and why the model works where clinics cannot reach.]]></excerpt:encoded>
