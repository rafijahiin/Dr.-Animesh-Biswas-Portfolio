  <!-- ─── PAGE 3: RESEARCH ─── -->
  <item>
    <title>Research</title>
    <link>https://animeshbiswas.com/research/</link>
    <pubDate>Wed, 27 May 2026 00:00:00 +0000</pubDate>
    <dc:creator><![CDATA[animesh]]></dc:creator>
    <guid isPermaLink="false">https://animeshbiswas.com/?page_id=4</guid>
    <description></description>
    <content:encoded><![CDATA[
<!-- wp:heading {"level":1} -->
<h1>Research</h1>
<!-- /wp:heading -->

<!-- wp:paragraph -->
<p><strong>130+ publications</strong> across peer-reviewed journals, WHO/UNFPA technical reports, and global guidance contributions. Below: selected highlights.</p>
<!-- /wp:paragraph -->

<!-- wp:heading -->
<h2>Selected Publications</h2>
<!-- /wp:heading -->

<!-- wp:heading {"level":3} -->
<h3>Bangladesh Case Study: MPDSR at Community &amp; Facility Level</h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p><strong>2024 · WHO · Global report</strong></p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>Contribution to the WHO Global MPDSR Report 2024. A field-grounded account of how Maternal Perinatal Death Surveillance and Response moves from data to action, from policy framework to community trust.</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3} -->
<h3>Cash &amp; Voucher Assistance for SRH in Humanitarian Emergencies</h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p><strong>2023 · UNFPA · Technical paper</strong></p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>Lessons from Bangladesh — the design, delivery and outcomes of a pioneering CVA programme for reproductive health, now replicated across multiple country contexts.</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3} -->
<h3>Reducing Maternal Mortality at Community and Facility Level</h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p><strong>2022 · Journal · Peer-reviewed</strong></p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>Evidence from field operations across rural Bangladesh — what works, what scales, and what the data tells us about where lives are saved.</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3} -->
<h3>Advancing the MPDSR Agenda</h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p><strong>2021 · WHO TWG · Working paper</strong></p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>Technical contributions to the global policy framework and country-level implementation.</p>
<!-- /wp:paragraph -->

<!-- wp:heading {"level":3} -->
<h3>Obstetric Fistula in Hard-to-Reach Areas</h3>
<!-- /wp:heading -->
<!-- wp:paragraph -->
<p><strong>2020 · UNFPA · Field study</strong></p>
<!-- /wp:paragraph -->
<!-- wp:paragraph -->
<p>Prevention and response in the Bangladesh Rohingya emergency context.</p>
<!-- /wp:paragraph -->

<!-- wp:paragraph -->
<p><em>For the full bibliography, see <a href="https://www.researchgate.net/scientific-contributions/Animesh-Biswas-2229204850">ResearchGate</a> or <a href="mailto:animeshbiswas@gmail.com?subject=Bibliography%20request">request a copy via email</a>.</em></p>
<!-- /wp:paragraph -->
]]></content:encoded>
